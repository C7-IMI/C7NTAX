# C7NTAX — production environment template (PLAN-016)
#
# Copy to Key Vault as individual secrets; the Container App receives them as secretRefs
# backed by the managed identity, so none of this is written into an image or a repository.
# Names below are the environment-variable names the API actually reads — the list is
# verified by scripts/azure/preflight.mjs against the source.
#
# Replace every <...> placeholder. Nothing here has a working default in production.

# ── Core ──
NODE_ENV=production
PORT=4000
# Public https origin of the Front Door / App Gateway endpoint (no trailing slash).
WEB_ORIGIN=https://<app-hostname>
# Gates CORS and every redirect the app builds (SSO callback, desktop hand-off, reset links).
CORS_ORIGIN=https://<app-hostname>
API_PUBLIC_URL=https://<app-hostname>

# ── Data ──
# Postgres Flexible Server, VNet-injected with no public endpoint; sslmode=require is mandatory.
DATABASE_URL=postgresql://<user>:<password>@<server>.postgres.database.azure.com:5432/c7_overwatch?sslmode=require&connection_limit=10

# ── Secrets: generated per environment, never copied from dev ──
# openssl rand -base64 48
JWT_SECRET=<64-char-random>
# Required: the Kumo vault derives its key from this. Losing it loses every stored credential.
KUMO_MASTER_KEY=<base64-32-bytes>

# ── Authentication policy ──
# true in production: 15-minute tokens, lockout after 5 failures, forced password change.
AUTH_HARDENING_ENABLED=true
PASSKEY_ENABLED=true
WEBAUTHN_RP_ID=<app-hostname>
# Cookie sessions (PLAN-001). Set to false only to fall back to token-only authentication;
# the bearer-token path is the desktop shell's and the add-in's, and it stays available either way.
SESSION_AUTH_ENABLED=true
# Leave AUTH_TEST_BYPASS unset. It refuses to run in production and exists for local testing.

# ── Inbound mail connector ──
EMAIL_CONNECTORS_ENABLED=true
EMAIL_CONNECTORS_CLOUD_ENABLED=true
EMAIL_GRAPH_ENABLED=true
EMAIL_OAUTH_REDIRECT_URI=https://<app-hostname>/api/email-connectors/oauth/callback
EMAIL_MAX_ATTACHMENT_BYTES=26214400

# ── Outbound mail ──
SMTP_HOST=<smtp-host>
SMTP_PORT=587
SMTP_USER=<smtp-user>
SMTP_PASS=<smtp-password>
SMTP_FROM=servicedesk@<domain>

# ── Single sign-on (PLAN-017) ──
SSO_ENABLED=<true|false>
SSO_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0
SSO_CLIENT_ID=<app-registration-client-id>
SSO_CLIENT_SECRET=<app-registration-secret>
SSO_REDIRECT_URI=https://<app-hostname>/api/auth/sso/oidc/callback

# ── Features ──
ALERT_WEBHOOKS_ENABLED=true
# Agreements, overtime weighting and the midnight split (PLAN-015 Phase A #1). Leave off until the
# billing chain has been through QA: off means time entries are stored exactly as they are typed.
TIME_RULES_ENABLED=<true|false>
# Bill-through batch invoicing (PLAN-015 Phase A #3). Off returns 404 for the batch routes, which
# is the rollback: no preview, no drafts, nothing to approve.
INVOICE_BATCH_ENABLED=<true|false>
UPTIME_MONITORS_ENABLED=true
# Knowledge base articles drafted by AI from resolved tickets (PLAN-015 Phase B #11). A draft is
# only ever a draft: a person publishes or discards it. Off means resolving a ticket drafts nothing.
M365_OFFBOARD_ENABLED=<true|false>
KB_AUTOGEN_ENABLED=<true|false>
KB_AUTOGEN_MODEL=<optional cheaper deployment for drafting; falls back to INFERENCE_MODEL>
# CloudConnect live status (PLAN-015 Phase B #9). The server verifies connections on a throttle and
# reports what it last observed; switching it off returns only the stored status and makes no calls.
CLOUDCONNECT_LIVE_STATUS_ENABLED=<true|false>
CLOUDCONNECT_VERIFY_INTERVAL_SEC=300
# Social reports for Service Alerts (PLAN-015 Phase B #8). The X source is off unless a bearer
# token is present, and it can only ever raise an INFORMATIONAL notice — social chatter is a
# signal, not proof of an outage. Set SERVICE_ALERTS_SOCIAL_ENABLED=false to keep it off even
# with a token, and X_API_BASE_URL only if you must point at a different host.
SERVICE_ALERTS_SOCIAL_ENABLED=<true|false>
X_BEARER_TOKEN=<x-api-bearer-token>
X_API_BASE_URL=https://api.x.com
OUTLOOK_ADDIN_ENABLED=true
# Where the add-in's static folder is mounted from (default: apps/outlook-addin in the image).
# Only needed if the image layout differs.
OUTLOOK_ADDIN_DIR=<absolute path to the add-in folder>
AI_ACTIONS_ENABLED=true
QUOTES_ENABLED=true
BILLING_FROM_TICKETS_ENABLED=true
# ── Customer portal (PLAN-013 #3) ──
# Absent unless set to "true": every /api/portal route answers 404, so a deployment that has not
# switched it on does not advertise a customer sign-in page. Sign-in is an emailed six-digit code
# (needs SMTP), and a client's contacts can only use it once an administrator turns on "Portal
# access" on that client. PORTAL_DEFAULT_BOARD_ID is optional: without it portal tickets land on
# the oldest active service board. The portal is served by the SPA at /portal.
PORTAL_ENABLED=<true|false>
PORTAL_DEFAULT_BOARD_ID=<service board id>
PUSH_ENABLED=true

# ── Inference ──
# Azure OpenAI or a containerised OpenAI-compatible endpoint. The egress policy blocks
# private addresses unless EGRESS_ALLOW_PRIVATE=true, so an in-VNet endpoint needs it.
INFERENCE_MODEL=<deployment-name>
EGRESS_ALLOW_PRIVATE=<true if the model endpoint is inside the VNet>

# ── Storage ──
# Mounted blob container for ticket attachments (Azure Files mount or blob-backed path).
TICKET_ATTACHMENT_DIR=/mnt/attachments

# ── Serving ──
# One image serves the API and the built SPA (PLAN-016). Both are set by the image itself;
# they are listed here because changing them changes what the container answers.
SERVE_WEB=true
WEB_DIST=/repo/web
