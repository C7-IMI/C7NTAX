  {
    "id": "915b5966-b891-45ef-8e63-43447a8d9127",
    "articleId": "012e5d73-fadb-4188-bb04-b527dea9adb5",
    "version": 2,
    "content": "<h2>Before you start</h2><p>You will need your company email address and the phone you use for MFA.</p><ol><li>Open the Cisco AnyConnect client.</li><li>Enter <strong>vpn.example.com</strong> and select Connect.</li><li>Approve the Duo prompt on your phone.</li></ol><p>If the profile is missing, re-import the XML file from the IT portal.</p>",
    "changeNote": "Added screenshots and the escalation path",
    "authorId": "8c30a256-55ea-4650-8fb5-58a336b1bf8b",
    "createdAt": "2026-10-06T20:16:16.843Z"
  },
  {
    "id": "9f2b977a-37a4-405e-aca1-167f6b681a42",
    "articleId": "78bec033-f117-4a8d-9a22-4a1544f15a32",
    "version": 1,
    "content": "<p>Initial draft.</p>",
    "changeNote": "Created",
