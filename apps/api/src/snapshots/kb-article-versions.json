  {
    "id": "4d896a4a-5d2c-4374-8bdb-2184f1f04902",
    "articleId": "62d36c14-fb89-4bb3-8f5d-7a0169d4c5ab",
    "version": 2,
    "content": "<h2>Do not click</h2><p>Do not open attachments or follow links. Report the message using the Report Phishing button.</p><p>Our team reviews every report and will get back to you if action is needed on your account.</p>",
    "changeNote": "Added screenshots and the escalation path",
    "authorId": "8c30a256-55ea-4650-8fb5-58a336b1bf8b",
    "createdAt": "2026-10-06T20:16:16.862Z"
