  createdById  String
  startedAt    DateTime?
  completedAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ═══════════════════════════════════════════════════════════════════

// ═══════════════════════════════════════════════════════════════════
//  KUMO — IT Documentation & Asset Management Module
// ═══════════════════════════════════════════════════════════════════

model KumoLink {
  id            String   @id @default(uuid())
  sourceType    String
  sourceId      String
  targetType    String
  targetId      String
  relationship  String   @default("related_to")
  label         String?
  notes         String?
  isDirectional Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdById   String
  createdAt     DateTime @default(now())

  @@index([sourceType, sourceId])
  @@index([targetType, targetId])
  @@index([sourceType, sourceId, targetType, targetId])
}

model KumoAssetTemplate {
  id          String   @id @default(uuid())
  name        String
  description String?
  icon        String?
  color       String?  @default("#3b82d6")
  isBuiltIn   Boolean  @default(false)
  isActive    Boolean  @default(true)
  companyId   String?
  fields      KumoTemplateField[]
  assets      KumoAsset[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model KumoTemplateField {
  id           String            @id @default(uuid())
  templateId   String
  template     KumoAssetTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  key          String
  label        String
  fieldType    String            @default("text")
  required     Boolean           @default(false)
  options      Json?
  placeholder  String?
  helpText     String?
  defaultValue Json?
  isSensitive  Boolean           @default(false)
  encrypted    Boolean           @default(false)
  sortOrder    Int               @default(0)
  values       KumoAssetFieldValue[] @relation("FieldToValues")

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([templateId, key])
}

model KumoAsset {
  id            String            @id @default(uuid())
  templateId    String
  template      KumoAssetTemplate @relation(fields: [templateId], references: [id])
  name          String
  status        String            @default("active")
  companyId     String?
  tags          String[]          @default([])
  createdById   String
  updatedById   String?
  fieldValues   KumoAssetFieldValue[] @relation("AssetToValues")
  configServer      KumoServer?
  configWorkstation KumoWorkstation?
  configNetwork     KumoNetworkDevice?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([templateId, companyId])
}

model KumoAssetFieldValue {
  id             String            @id @default(uuid())
  assetId        String
  asset          KumoAsset         @relation("AssetToValues", fields: [assetId], references: [id], onDelete: Cascade)
  fieldId        String
  field          KumoTemplateField @relation("FieldToValues", fields: [fieldId], references: [id])
  valueText      String?
  valueNum       Float?
  valueBool      Boolean?
  valueDate      DateTime?
  valueJson      Json?
  encryptedValue String?

  @@unique([assetId, fieldId])
  @@index([fieldId])
}

model KumoServer {
  id              String    @id @default(uuid())
  kumoAssetId     String    @unique
  kumoAsset       KumoAsset @relation(fields: [kumoAssetId], references: [id], onDelete: Cascade)
  hostname        String
  fqdn            String?
  operatingSystem String?
  osVersion       String?
  cpuCores        Int?
  ramGb           Int?
  storageGb       Int?
  ipAddress       String?
  macAddress      String?
  virtualization  String?
  hypervisorHost  String?
  lastPatchedAt   DateTime?
}

model KumoWorkstation {
  id              String    @id @default(uuid())
  kumoAssetId     String    @unique
  kumoAsset       KumoAsset @relation(fields: [kumoAssetId], references: [id], onDelete: Cascade)
  hostname        String
  operatingSystem String?
  serialNumber    String?
  assignedUserId  String?
  lastCheckInAt   DateTime?
}

model KumoNetworkDevice {
  id              String    @id @default(uuid())
  kumoAssetId     String    @unique
  kumoAsset       KumoAsset @relation(fields: [kumoAssetId], references: [id], onDelete: Cascade)
  deviceType      String    @default("switch")
  managementIp    String?
  macAddress      String?
  firmwareVersion String?
  portCount       Int?
  serialNumber    String?
  rackPosition    String?
}

model KumoPassword {
  id                String   @id @default(uuid())
  label             String
  username          String?
  email             String?
  url               String?
  encryptedPassword String
  encryptionKeyId   String
  iv                String
  authTag           String
  passwordPolicy    String?
  expiresAt         DateTime?
  category          String?
  strength          String?
  notes             String?
  companyId         String?
  totpSecret        String?
  totpEnabled       Boolean  @default(false)
  isActive          Boolean  @default(true)
  createdById       String
  updatedById       String?
  accessLogs        KumoPasswordAccessLog[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([companyId, category])
}

/// Who changed what in Kumo (PLAN-015 Phase B #6). Shared credentials and documents are edited by
/// many hands, and "last editor" alone cannot answer "who removed the DNS entry?".
model KumoAuditLog {
  id        String   @id @default(uuid())
  itemType  String   // password | document | asset | config | link
  itemId    String
  action    String   // created | updated | deleted | revealed | viewed
  userId    String?
  /// A short human sentence for the panel; details carry the field-level facts.
  summary   String?
  details   Json     @default("{}")
  at        DateTime @default(now())

  @@index([itemType, itemId, at])
  @@index([userId])
}

model KumoPasswordAccessLog {
  id            String       @id @default(uuid())
  passwordId    String
  password      KumoPassword @relation(fields: [passwordId], references: [id], onDelete: Cascade)
  accessedById  String
  accessedAt    DateTime     @default(now())
  accessType    String
  ipAddress     String?
  userAgent     String?
  success       Boolean      @default(true)
  failureReason String?

  @@index([passwordId, accessedAt])
  @@index([accessedById])
}

model KumoFolder {
  id          String       @id @default(uuid())
  name        String
  slug        String
  description String?
  parentId    String?
  parent      KumoFolder?  @relation("FolderHierarchy", fields: [parentId], references: [id])
  children    KumoFolder[] @relation("FolderHierarchy")
  sortOrder   Int          @default(0)
  companyId   String?
  documents   KumoDocument[]

  @@unique([slug, parentId, companyId])
  @@index([parentId])
}

model KumoDocument {
  id             String      @id @default(uuid())
  folderId       String?
  folder         KumoFolder? @relation(fields: [folderId], references: [id])
  title          String
  slug           String
  currentContent String
  currentVersion Int         @default(1)
  status         String      @default("draft")
  visibility     String      @default("internal")
  sortOrder      Int         @default(0)
  companyId      String?
  tags           String[]    @default([])
  authorId       String
  lastEditorId   String?
  viewCount      Int         @default(0)
  isTemplate     Boolean     @default(false)
  revisions      KumoDocumentRevision[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([folderId, sortOrder])
  @@index([companyId, status])
}

model KumoDocumentRevision {
  id         String        @id @default(uuid())
  documentId String
  document   KumoDocument  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  version    Int
  content    String
  changeLog  String?
  authorId   String
  fileSize   Int?
  createdAt  DateTime      @default(now())

  @@unique([documentId, version])
  @@index([documentId, createdAt])
}

// ── FlowIngest: Domain Tracking ───────────────────────────────────

model KumoDomain {
  id          String   @id @default(uuid())
  domainName  String
  registrar   String?
  expiryDate  DateTime?
  autoRenew   Boolean  @default(true)
  dnsProvider String?
  nameservers String[] @default([])
  notes       String?
  companyId   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([companyId])
  @@index([expiryDate])
}

// ── FI-031: Certificate/SSL Tracking ──────────────────────────────

model KumoCertificate {
  id               String   @id @default(uuid())
  name             String
  domain           String
  issuer           String?
  expiryDate       DateTime
  validFrom        DateTime?
  subjectAltNames  String[] @default([])
  certificateType  String?  @default("DV")
  autoRenew        Boolean  @default(false)
  notes            String?
  companyId        String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([companyId])
  @@index([expiryDate])
}

// ── FI-035: Kumo File Manager ─────────────────────────────────────

model KumoFile {
  id           String   @id @default(uuid())
  filename     String
  mimeType     String
  size         Int
  storagePath  String
  entityType   String?  // "client", "ticket", "kumo_asset"
  entityId     String?
  companyId    String?
  uploadedById String
  createdAt    DateTime @default(now())

  @@index([entityType, entityId])
  @@index([companyId])
}

// ── Checklists ─────────────────────────────────────────────────────
// A repeatable procedure for a client: a rich-text description plus an ordered
// list of tasks, each of which can be assigned, dated and ticked off.

model Checklist {
  id           String   @id @default(uuid())
  name         String
  description  String?  // rich HTML
  companyId    String
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  assignedToId String?
  assignedTo   User?    @relation("AssignedChecklists", fields: [assignedToId], references: [id])
  dueDate      DateTime?
  createdById  String
  createdBy    User     @relation("CreatedChecklists", fields: [createdById], references: [id])
  tasks        ChecklistTask[]

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([companyId])
  @@index([assignedToId])
  @@map("checklists")
}

model ChecklistTask {
  id            String    @id @default(uuid())
  checklistId   String
  checklist     Checklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)
  title         String
  notes         String?   // rich HTML
  position      Int       @default(0)
  completedAt   DateTime?
  completedById String?
  assignedToId  String?
  assignedTo    User?     @relation("AssignedChecklistTasks", fields: [assignedToId], references: [id])
  dueDate       DateTime?

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([checklistId])
  @@index([assignedToId])
  @@map("checklist_tasks")
}

// ── FI-038: Expense Tracking ───────────────────────────────────────

model Expense {
  id          String   @id @default(uuid())
  description String
  amount      Float
  category    String   @default("other")
  companyId   String?
  ticketId    String?
  invoiceId   String?
  receiptUrl  String?
  expenseDate DateTime @default(now())
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // ─── PLAN-015 Phase A #2: out-of-pocket costs and their approval ────
  vendor         String?
  /// Miles travelled, for the mileage category. The amount stays explicit: the rate is a policy
  /// decision that belongs to the business, not to this table.
  miles          Float?
  /// submitted → approved | rejected → billed once an invoice carries it.
  status         String   @default("submitted")
  approvedById   String?
  approvedAt     DateTime?
  decisionNote   String?
  /// Where an approved expense was pushed, and what the other system called it.
  externalSystem String?
  externalId     String?
  syncedAt       DateTime?

  @@index([companyId])
  @@index([category])
  @@index([status])
  @@index([ticketId])
}

// ── FI-040: Alerting System ────────────────────────────────────────

model AlertRule {
  id            String   @id @default(uuid())
  name          String
  entityType    String   // "domain", "certificate", "invoice", "password"
  triggerDays   Int      @default(30) // days before expiry to trigger
  enabled       Boolean  @default(true)
  notifyEmail   String?
  lastTriggered DateTime?
  createdById   String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model AlertLog {
  id            String   @id @default(uuid())
  ruleId        String?
  entityType    String
  entityId      String
  message       String
  severity      String   @default("warning") // "info", "warning", "critical"
  dismissed     Boolean  @default(false)
  dismissedBy   String?
  dismissedAt   DateTime?
  createdAt     DateTime @default(now())

  @@index([dismissed, createdAt])
}

// ── FI-041: Recently Viewed Items ──────────────────────────────────

model RecentlyViewedItem {
  id          String   @id @default(uuid())
  userId      String
  entityType  String   // "password", "config", "asset", "document", "domain", "certificate", "link"
  entityId    String
  entityName  String
  entityIcon  String   @default("document")  // icon hint for the frontend
  viewedAt    DateTime @default(now())

  @@unique([userId, entityType, entityId])
  @@index([userId, viewedAt])
}

// ── FI-060: Service Alerts ─────────────────────────────────────────

model ServiceAlertService {
  id              String   @id @default(uuid())
  name            String   @unique
  category        String   @default("other") // cloud, isp, telecom, collaboration, other
  description     String?  // short summary shown on dashboard cards
  statusPageUrl   String?  // official status page
  downDetectorUrl String?  // DownDetector status page
  rssUrl          String?  // RSS feed polled by the alert monitor
  monitorKind     String   @default("vendor") // vendor, website, ssl, dns
  monitorUrl      String?  // target URL/host for website/ssl/dns kinds
  monitorConfig   Json?    // e.g. { checkIntervalMin, expectStatus, sslWarnDays }
  monitorEnabled  Boolean  @default(true)
  enabled         Boolean  @default(true)
  sortOrder       Int      @default(0)
  alerts          ServiceAlert[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([enabled, sortOrder])
}

model ServiceAlert {
  id          String              @id @default(uuid())
  serviceId   String
  service     ServiceAlertService @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  title       String
  description String?
  severity    String              @default("outage") // outage, degraded, informational
  status      String              @default("active") // active, resolved
  source      String              @default("rss") // rss, statuspage, downdetector, manual
  sourceUrl   String?
  detectedAt  DateTime            @default(now())
  resolvedAt  DateTime?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([serviceId])
  @@index([status])
}

// ─── Backlog 2026-08-18 (feature-gated, additive) ───────────────────

model Quote {
  id          String          @id @default(uuid())
  quoteNumber String          @unique
  companyId   String
  company     Company         @relation(fields: [companyId], references: [id])
  contactId   String?
  title       String
  status      String          @default("draft") // draft, sent, accepted, rejected, converted
  subtotal    Float           @default(0)
  taxRate     Float           @default(0)
  taxTotal    Float           @default(0)
  total       Float           @default(0)
  notes       String?
  createdById String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  lineItems   QuoteLineItem[]

  @@index([companyId])
}

model QuoteLineItem {
  id          String @id @default(uuid())
  quoteId     String
  quote       Quote  @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  description String
  quantity    Float  @default(1)
  unitPrice   Float  @default(0)
  total       Float  @default(0)
  sortOrder   Int    @default(0)
  /// Set when the line came from the product catalog; an ad-hoc line leaves it null.
  productId   String?
}

/// A sellable or reorderable item: hardware, software, a licence, a subscription or a service.
/// The catalog is the single source of the description, price and billing period that tickets,
/// quotes, purchase orders and invoices copy from, so the same thing is never priced twice.
model Product {
  id             String   @id @default(uuid())
  sku            String   @unique
  name           String
  description    String?
  /// hardware | software | license | subscription | service | bundle | other
  productType    String   @default("hardware")
  /// Free-text grouping shown in the catalog's filters — "Networking", "Security", "Backup".
  category       String?
  subcategory    String?
  manufacturer   String?
  /// The vendor this is bought from, so procurement can suggest it when ordering.
  vendorId       String?
  vendorSku      String?
  /// each | hour | user | month | seat | GB | licence | day
  unit           String   @default("each")
  costPrice      Float    @default(0)
  sellPrice      Float    @default(0)
  /// none | monthly | quarterly | annual — a recurring price is what makes it a subscription.
  billingPeriod  String   @default("none")
  taxable        Boolean  @default(true)
  isActive       Boolean  @default(true)
  /// Stock is only counted for things that are held; licences and services usually are not.
  trackStock     Boolean  @default(false)
  stockOnHand    Int      @default(0)
  reorderPoint   Int?
  reorderQuantity Int?
  warrantyMonths Int?
  purchaseUrl    String?
  notes          String?
  createdById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([productType])
  @@index([category])
  @@index([isActive])
  @@index([vendorId])
}

model WebauthnCredential {
  id           String    @id @default(uuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentialId String    @unique
  publicKey    String
  counter      Int       @default(0)
  transports   String    @default("[]")
  /// User-facing label, e.g. "Chrome on Windows"; the management UI lists and renames this.
  deviceName   String?
  lastUsedAt   DateTime?
  createdAt    DateTime  @default(now())
}

model PushDevice {
  id         String    @id @default(uuid())
  userId     String?
  user       User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  token      String    @unique
  platform   String    @default("web") // web, ios, android
  lastSeenAt DateTime?
  createdAt  DateTime  @default(now())
}

/// A user's own dashboard: which widgets, in what order, at what size (PLAN-015 Phase B #4).
/// The row is keyed to the user, and the widgets it names are validated against a server-side
/// catalogue — a saved layout is a preference, not a program.
model UserDashboardConfig {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// [{ id, size, visible }] in display order.
  widgets   Json     @default("[]")
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

model AiAction {
  id            String          @id @default(uuid())
  entityType    String          // ticket, device, client
  entityId      String?
  title         String
  summary       String
  riskTier      String          @default("low") // low, medium, high, critical
  payload       Json?
  status        String          @default("pending") // pending, approved, executed, rejected, blocked
  requestedById String?
  decidedById   String?
  decidedAt     DateTime?
  audit         AiActionAudit[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([status])
}

model AiActionAudit {
  id       String   @id @default(uuid())
  actionId String
  action   AiAction @relation(fields: [actionId], references: [id], onDelete: Cascade)
  event    String   // proposed, approved, rejected, executed, blocked
  userId   String?
  detail   String?
  at       DateTime @default(now())
}

model AlertWebhookDelivery {
  id        String   @id @default(uuid())
  webhookId String
  event     String
  payload   String
  status    String   @default("pending") // pending, delivered, failed
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([status])
}

model OutlookAddinToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

// ─── Customer portal (PLAN-013 #3) ──────────────────────────────────

/// A one-time sign-in code emailed to a customer contact. Only the hash is stored,
/// so a database read cannot recover a live code.
model PortalLoginCode {
  id         String    @id @default(uuid())
  contactId  String
  contact    Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  codeHash   String
  attempts   Int       @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([contactId])
  @@index([expiresAt])
}

/// A signed-in customer contact. Deliberately separate from `UserSession`: a customer is
/// a Contact, not a staff User, and a portal token must never be usable on a staff route.
model PortalSession {
  id             String    @id @default(uuid())
  sessionToken   String    @unique // sha256 of the cookie value
  csrfToken      String
  contactId      String
  contact        Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  ipAddress      String?
  userAgent      String?
  lastActivityAt DateTime  @default(now())
  expiresAt      DateTime
  invalidatedAt  DateTime?
  createdAt      DateTime  @default(now())

  @@index([contactId])
  @@index([expiresAt])
}
