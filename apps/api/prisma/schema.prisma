// ─── Prisma Schema for C7NTAX ───────────────────────────────────
// Database: PostgreSQL 16
// ORM: Prisma Client

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── User & Auth ────────────────────────────────────────────────────

model User {
  id              String   @id @default(uuid())
  email           String   @unique
  username        String?  @unique
  passwordHash    String
  firstName       String
  lastName        String
  phone           String?
  mobile          String?
  title           String?
  avatarUrl       String?
  isActive        Boolean  @default(true)
  isLocked        Boolean  @default(false)
  loginAttempts   Int      @default(0)
  lastLoginAt     DateTime?
  emailVerified   Boolean  @default(false)

  // Credentials — a temporary password handed out by an admin is only good for
  // one sign-in. tokenVersion is stamped into every JWT and bumped whenever the
  // password changes, which retires tokens issued before the change.
  mustChangePassword Boolean   @default(false)
  passwordChangedAt  DateTime?
  tokenVersion       Int       @default(0)
  /// The hashes of the passwords this account has had, most recent first, capped at
  /// `PASSWORD_HISTORY_DEPTH` (5). A new password is refused if it matches one of them, so somebody
  /// cannot cycle a small set of passwords and defeat the expiry that keeps them changing.
  ///
  /// **Hashed rather than remembered in clear**, and deliberately so: a history is a list of credentials
  /// that used to work, and the only reason it is kept at all is to answer "is this one of them" — which
  /// bcrypt can answer without the database ever holding the password itself. The list is never returned
  /// by any route; it exists to be compared against and appended to.
  previousPasswordHashes String[] @default([])

  // Placement — parity with Autotask "Resources" and Asio "Members"
  department      String?
  timezone        String?
  /// Where this person lands after signing in, as a route path. Null means "use the instance
  /// default", which is deliberate: it keeps a later change to the default reaching everyone who
  /// never chose one. Personal rather than instance-wide, which is why it is not in SystemConfig.
  landingPage     String?
  /// The Outlook add-in's saved answers — whether several messages are filed as one ticket each,
  /// whether the review is offered, and the last board used. Per user rather than per device: the
  /// taskpane's own storage is shared by every account that signs in on that machine, and these
  /// settings decide whether a ticket is filed without asking.
  addinPreferences Json?
  /// What an hour of this person's time costs us, used by the margin reports. Null means
  /// "not recorded", which the reports state rather than assuming a figure.
  costRate        Float?
  reportsToId     String?
  reportsTo       User?     @relation("UserReportsTo", fields: [reportsToId], references: [id], onDelete: SetNull)
  directReports   User[]    @relation("UserReportsTo")

  // MFA — what the account has enrolled. These four are the sign-in's facts: `mfaEnabled` is what
  // makes a second factor be asked for, `mfaSecret` is the authenticator seed, and the email code is
  // the short-lived fallback that is sent on demand.
  mfaEnabled        Boolean  @default(false)
  mfaSecret         String?
  /// Hashed (bcrypt), one per code. The plaintext is shown once, at generation, and never stored —
  /// which is why nothing can display them again and why the reset below exists.
  mfaBackupCodes    String[] @default([])
  mfaEmailCode      String?
  mfaEmailCodeExpires DateTime?

  // MFA — the policy, which is a different question from the facts above. `mfaState` says whether
  // this account is required to have a second factor: `default` follows the instance setting,
  // `disabled` exempts the account from a requirement, `enforced` requires it regardless. The words
  // are Entra's, so an administrator who has used Entra already knows them. `mfaMethod` records which
  // method they chose, so the sign-in asks for the right second factor and the administrator knows
  // what to tell them to use. `mfaGraceUntil` is the deadline given to an account when a requirement
  // was first switched on; a future date means "remind, do not block yet", which is what allows the
  // requirement to be turned on without locking out everyone who has not enrolled.
  mfaState          String    @default("default") // default | disabled | enforced
  mfaMethod         String?                        // totp | passkey | email_code
  mfaEnrolledAt     DateTime?
  mfaGraceUntil     DateTime?

  // Relationships
  roleId          String
  role            Role              @relation(fields: [roleId], references: [id])
  permissions     String[]          @default([])  // individual overrides (additive to role)
  /// Permissions removed from this person that their role grants. A **strict subtraction**: a value
  /// here can only take a permission away, never add one, so it can narrow an account and cannot widen
  /// one. It exists because the additive override above cannot express "everyone in this role except
  /// them" — the console is the first permission where that question is routine rather than exotic.
  deniedPermissions String[]        @default([])
  companyId       String?
  company         Company?          @relation(fields: [companyId], references: [id])
  sessions        Session[]
  tickets         Ticket[]          @relation("AssignedTickets")
  createdTickets  Ticket[]          @relation("CreatedTickets")
  checklists         Checklist[]      @relation("AssignedChecklists")
  createdChecklists  Checklist[]      @relation("CreatedChecklists")
  checklistTasks     ChecklistTask[]  @relation("AssignedChecklistTasks")
  comments        TicketComment[]
  timeEntries     TimeEntry[]
  notifications   Notification[]
  webauthnCredentials WebauthnCredential[]
  pushDevices     PushDevice[]
  signInEvents    SignInEvent[]
  dashboardConfig UserDashboardConfig?
  navConfig       UserNavConfig?
  outlookAddinTokens OutlookAddinToken[]
  apiKeys         ApiKey[]          @relation("ApiKeyOwner")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  systemRole  String   // SystemRole enum value
  permissions String[] // Permission enum values
  isDefault   Boolean  @default(false)
  users       User[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Session {
  id           String   @id @default(uuid())
  token        String   @unique
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ipAddress    String?
  userAgent    String?
  expiresAt    DateTime
  createdAt    DateTime @default(now())
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())
}

// ─── Sessions (PLAN-001) ────────────────────────────────────────────
// Server-side session for browser clients. The cookie holds a random token; only its
// SHA-256 hash is stored, so a database leak cannot be replayed as a session. The CSRF
// token is stored separately and echoed back in a header for state-changing requests,
// because a cookie is sent automatically by the browser and a header is not.
// No relation on purpose: the opposite field on User would be dead weight for a table
// that is queried by token and pruned by expiry.
model UserSession {
  id             String    @id @default(uuid())
  sessionToken   String    @unique // sha256 of the cookie value
  csrfToken      String
  userId         String
  ipAddress      String?
  userAgent      String?
  lastActivityAt DateTime  @default(now())
  expiresAt      DateTime
  invalidatedAt  DateTime?
  createdAt      DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

/// One sign-in attempt or outcome: Entra's sign-in log, in miniature (PLAN: security audit).
///
/// Every way in writes one — the password form, the MFA step, a passkey, the OIDC exchange, a portal
/// code — successes and failures alike, because the failures are what an audit is *for*. `userId` is
/// null when the address typed was not an account: the attempt still happened, and a blank user is
/// more honest than dropping the row. The method is recorded separately from the result because
/// "signed in with a passkey" and "signed in with a password" are different facts about a person, and
/// the second is the one worth asking about.
model SignInEvent {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  /// What was typed, which is not always an account that exists.
  email     String
  /// success | failure | locked | mfa_failed | code_failed | signed_out
  result    String
  /// password | totp | email_code | passkey | sso | portal_code
  method    String
  /// Why it failed, in the words the screen shows a reader.
  reason    String?
  ipAddress String?
  userAgent String?
  /// Parsed from the user agent, e.g. "Chrome on Windows". Null when it could not be read.
  device    String?
  /// The `UserSession` this sign-in opened, so a session can be traced back to how it began.
  sessionId String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([result, createdAt])
}

// ─── Tenant / MSP Multi-Tenancy ────────────────────────────────────

model Tenant {
  id        String   @id @default(uuid())
  name      String   @unique
  domain    String?  @unique
  settings  Json     @default("{}")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  companies Company[]
}

// ─── Company / Client ───────────────────────────────────────────────

model Company {
  id              String   @id @default(uuid())
  tenantId        String?
  tenant          Tenant?  @relation(fields: [tenantId], references: [id])
  name            String
  legalName       String?
  taxId           String?
  phone           String?
  fax             String?
  email           String?
  billingEmail    String?
  website         String?
  addressLine1    String?
  addressLine2    String?
  city            String?
  state           String?
  postalCode      String?
  country         String?
  billingAddressLine1 String?
  billingAddressLine2 String?
  billingCity     String?
  billingState    String?
  billingPostalCode String?
  billingCountry  String?
  notes           String?
  isActive        Boolean  @default(true)
  clientId        Int?     @unique
  clientType      String?  @default("Client")
  companyType     String?  @default("Client") // Client, Prospect, Vendor, Partner
  industry        String?
  territory       String?
  region          String?
  currency        String?  @default("USD")
  accountManagerId String?
  primaryContactId String?
  serviceLevel    String?  // Standard, Premium, Enterprise

  // Portal access
  portalEnabled   Boolean  @default(false)
  /// Accent colour for the customer portal, `#rrggbb`. Null uses the app's own theme.
  portalAccentColor String?
  /// Logo shown on the portal, absolute URL or a path under the API's `/uploads`.
  portalLogoUrl   String?
  /// The client's own branding for documents addressed to it, as `BrandOverride` in
  /// `packages/shared/src/brand.ts` — an entity invoiced under its own name and address.
  ///
  /// Every field is optional and absent means "the instance's own", so a client whose form was never
  /// filled in produces exactly the document it produced before this column existed. `portalLogoUrl`
  /// above is the *portal's* logo from an earlier era; where a client has one and no `logoUrl` here,
  /// the document falls back to it, because a client has one logo and two would drift.
  brandOverride   Json?

  // Portal policy for this client. A null on any of these means "use the instance's own
  // setting" — so a deployment configures the portal once and only the clients that differ
  // carry values of their own. See `services/portalPolicy.ts`.
  /// `contact` (their own tickets) or `company` (every ticket at this client).
  portalVisibility String?
  portalAllowTicketCreation Boolean?
  portalAllowReplies Boolean?
  /// Where this client's portal-raised tickets land. Null uses the instance's board.
  portalBoardId   String?

  /// The console for this client's staff. **Null inherits** the instance's switch — the same
  /// three-valued pattern the portal policy above uses, so a deployment that does not care about the
  /// console never has to set this on a client, and `false` is a deliberate exception rather than the
  /// default. Applied where permissions are computed (`effectivePermissions`), not in the interface, so
  /// a client with the console off is answered the same way a person without the permission is: their
  /// session does not carry `console:use`, and the icon is not drawn because there is nothing to draw.
  consoleEnabled  Boolean?

  /// How far this client has been billed by a bill-through batch (PLAN-015 Phase A #3).
  billThroughDate DateTime?

  // Sub-organizations (HQ, branches, departments)
  parentId        String?
  parent          Company?  @relation("CompanyHierarchy", fields: [parentId], references: [id])
  children        Company[] @relation("CompanyHierarchy")

  // Relationships
  users           User[]
  contacts        Contact[]
  quotes          Quote[]
  tickets         Ticket[]
  serviceAgreements ServiceAgreement[]
  invoices        Invoice[]
  checklists      Checklist[]
  emailConnectorDefaults EmailConnector[] @relation("EmailConnectorDefaultCompany")

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([parentId])
}

model Contact {
  id          String   @id @default(uuid())
  firstName   String
  lastName    String
  email       String
  phone       String?
  mobile      String?
  title       String?
  department  String?
  notes       String?
  isPrimary   Boolean  @default(false)
  isActive    Boolean  @default(true)

  // Portal overrides for this person, against their client's policy: the office manager who
  // sees every ticket at the client where their colleagues see only their own, and the
  // contractor who has no portal at all. Null follows the client.
  /// False refuses the portal to this contact; true or null follows the client.
  portalAccess Boolean?
  /// `contact` or `company`. Null follows the client's own setting.
  portalVisibility String?

  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  tickets     Ticket[]
  ticketContacts TicketContact[]
  portalLoginCodes PortalLoginCode[]
  portalSessions   PortalSession[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ─── Service Boards ─────────────────────────────────────────────────

model ServiceBoard {
  id              String   @id @default(uuid())
  name            String
  description     String?
  ticketCode      String?  // optional prefix filter (e.g., "MSP" filters ticketNumber starting with "MSP-")
  isActive        Boolean  @default(true)

  // SLA defaults
  slaResponseMinutes   Int  @default(240)   // 4 hours
  slaResolutionMinutes Int  @default(1440)  // 24 hours

  // Auto-close config
  autoCloseEnabled     Boolean @default(true)
  autoCloseDays        Int     @default(14)

  // Follow-up email config
  followUpEnabled      Boolean @default(true)
  followUpIntervalHours Int    @default(24)

  // Whether closing or resolving a ticket on this board emails the client.
  //
  // On for every board, and off only where the client contact is not a person: a NOC board's tickets
  // arrive from automated systems, whose addresses are no-reply, so the closure email is sent to
  // nobody and the noise is mistaken for a notification. The close dialog starts from this, and an
  // operator can still tick the box to send one.
  notifyCustomerOnClose Boolean @default(true)

  // Relationships
  tickets         Ticket[]
  emailConnectors EmailConnector[]
  categories      TicketCategory[]
  layout          BoardLayout?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

/// How a board's metric tiles are arranged (PLAN-015 Phase B #5). One row per board: the tiles a
/// board card shows are the same for everybody, so this is a team-level arrangement — pinned
/// tiles first, then the order somebody chose — rather than a per-user preference.
model BoardLayout {
  id        String       @id @default(uuid())
  boardId   String       @unique
  board     ServiceBoard @relation(fields: [boardId], references: [id], onDelete: Cascade)
  /// [{ id, pinned }] in display order.
  tiles     Json         @default("[]")
  updatedById String?
  updatedAt DateTime     @updatedAt
  createdAt DateTime     @default(now())
}

model TicketCategory {
  id        String  @id @default(uuid())
  name      String
  boardId   String
  board     ServiceBoard @relation(fields: [boardId], references: [id], onDelete: Cascade)
  tickets   Ticket[]

  @@unique([boardId, name])
}

// ─── Email Connectors ──────────────────────────────────────────────

model EmailConnector {
  id                String   @id @default(uuid())
  boardId           String
  board             ServiceBoard @relation(fields: [boardId], references: [id], onDelete: Cascade)
  host              String
  port              Int      @default(993)
  secure            Boolean  @default(true)
  user              String
  passwordEncrypted String
  folder            String   @default("INBOX")
  transport         String   @default("imap") // imap, ews, graph
  authType          String   @default("basic") // basic (imap/ews), clientSecret | delegated (graph)
  clientId          String?  // Graph OAuth (transport=graph)
  clientSecretEncrypted String?
  tenantId          String?  // Graph tenant or "common"

  // Delegated OAuth ("Connect to Microsoft", authorization code + PKCE). Only the
  // signed-in account's own mailbox is read, so no app-only permission is needed;
  // the refresh token is rotated on every use and stored encrypted.
  oauthRefreshTokenEncrypted String?
  oauthAccount      String?  // UPN the consent was granted for
  oauthScopes       String?
  oauthConnectedAt  DateTime?

  // Ingestion rules (how a sender that matches nothing is attributed)
  defaultCompanyId  String?
  defaultCompany    Company? @relation("EmailConnectorDefaultCompany", fields: [defaultCompanyId], references: [id], onDelete: SetNull)
  autoCreateCompany Boolean  @default(false)
  autoCreateContact Boolean  @default(true)
  markSeenOnSuccess Boolean  @default(true)
  ignoreAutoReplies Boolean  @default(true)

  pollIntervalSec   Int      @default(60)
  enabled           Boolean  @default(true)
  lastPollAt        DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

// ─── Tickets ────────────────────────────────────────────────────────
model Ticket {
  id          String   @id @default(uuid())
  ticketNumber String  @unique // Auto-generated e.g. C7-00000001
  title       String
  description String?
  status      String   @default("new")       // TicketStatus enum
  priority    String   @default("medium")    // TicketPriority enum
  source      String   @default("portal")    // TicketSource enum
  dueDate     DateTime?
  startTime   DateTime?
  endTime     DateTime?

  // SLA tracking
  slaResponseDue    DateTime?
  slaResolutionDue  DateTime?
  firstResponseAt   DateTime?
  resolvedAt        DateTime?
  closedAt          DateTime?
  isOverdue         Boolean   @default(false) // Auto-set when dueDate passes

  // Auto-close tracking
  waitingSince      DateTime?  // When status changed to waiting_on_client
  followUpCount     Int        @default(0)
  lastFollowUpAt    DateTime?

  // Relationships
  boardId       String
  board         ServiceBoard     @relation(fields: [boardId], references: [id])
  categoryId    String?
  category      TicketCategory?  @relation(fields: [categoryId], references: [id])
  companyId     String
  company       Company          @relation(fields: [companyId], references: [id])
  contactId     String?
  contact       Contact?         @relation(fields: [contactId], references: [id])
  assignedToId  String?
  assignedTo    User?            @relation("AssignedTickets", fields: [assignedToId], references: [id])
  createdById   String
  createdBy     User             @relation("CreatedTickets", fields: [createdById], references: [id])

  // Thread
  comments      TicketComment[]
  attachments   TicketAttachment[]
  timeEntries   TimeEntry[]
  notifications Notification[]

  // Extra stakeholders beyond the primary `contact` — CCs and additional contacts
  additionalContacts TicketContact[]

  // Tags / metadata
  tags          String[]  @default([])
  customFields  Json      @default("{}")

  // Service agreement link
  serviceAgreementId String?
  serviceAgreement   ServiceAgreement? @relation(fields: [serviceAgreementId], references: [id])

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

/// Extra people on a ticket beyond the primary `Ticket.contact`.
/// `cc` — copied on every customer-facing notification and ticket email.
/// `additional` — recorded on the ticket and selectable per note, but not copied automatically.
model TicketContact {
  id           String   @id @default(uuid())
  ticketId     String
  ticket       Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  contactId    String
  contact      Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  role         String   @default("cc")
  /// Whether a customer-facing note is emailed to them by default.
  notifyOnNote Boolean  @default(true)
  createdAt    DateTime @default(now())

  @@unique([ticketId, contactId])
  @@map("ticket_contacts")
}

model TicketComment {
  id          String   @id @default(uuid())
  body        String
  isInternal  Boolean  @default(false)
  isEmail     Boolean  @default(false) // true if ingested from email
  fromEmail   String?  // sender email if email-sourced

  ticketId    String
  ticket      Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId    String
  author      User     @relation(fields: [authorId], references: [id])

  attachments TicketAttachment[]


  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model TicketAttachment {
  id          String   @id @default(uuid())
  filename    String
  mimeType    String
  size        Int
  storagePath String
  ticketId    String?
  ticket      Ticket?  @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  commentId   String?
  comment     TicketComment? @relation(fields: [commentId], references: [id], onDelete: Cascade)
  uploadedById String

  createdAt   DateTime @default(now())
}

// ─── Time Entry ─────────────────────────────────────────────────────

model TimeEntry {
  id          String   @id @default(uuid())
  description String?
  internalNotes String?
  minutes     Int
  billable    Boolean  @default(true)
  noCharge    Boolean  @default(false)
  rate        Float?
  date        DateTime @default(now())
  startTime   DateTime?
  endTime     DateTime?
  workType    String?
  workRole    String?

  ticketId    String
  ticket      Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id])

  invoiceId   String?
  invoice     Invoice? @relation(fields: [invoiceId], references: [id])

  // ─── Time rules (PLAN-015 Phase A #1), computed when TIME_RULES_ENABLED is on ────
  /// Minutes worked after the agreement's overtime cut-off.
  overtimeMinutes Int     @default(0)
  /// Minutes that count for billing and against block balances — the plain minutes plus the
  /// overtime weighting. Null when the rules were off, so "not computed" is distinguishable.
  billedMinutes   Int?
  /// The entry this one was split from when the work crossed midnight.
  splitFrom       String?
  agreementId     String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ─── Service Agreements & Billing ──────────────────────────────────

model ServiceAgreement {
  id            String   @id @default(uuid())
  name          String
  description   String?
  companyId     String
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  isActive      Boolean  @default(true)

  // Billing config
  billingPeriod String   @default("monthly")   // BillingPeriod enum
  billingAmount Float    @default(0)
  currency      String   @default("USD")
  taxRate       Float    @default(0)            // e.g. 0.0825 = 8.25%

  // Dates
  startDate     DateTime
  endDate       DateTime?
  nextInvoiceDate DateTime?

  // Auto-invoice settings
  autoInvoiceEnabled    Boolean @default(true)
  invoiceDayOfMonth     Int     @default(1)
  invoiceAdvanceDays    Int     @default(7)

  // Auto follow-up for unpaid
  followUpEnabled       Boolean @default(true)
  followUpIntervalDays  Int     @default(7)
  maxFollowUps          Int     @default(3)

  // ─── Agreement type & time rules (PLAN-015 Phase A #1) ────────────
  /// "service" — flat recurring amount; "block" — prepaid hours; "cyberCare" — subscription with
  /// an included allowance; "spot" — hourly at the agreement's rate.
  agreementType      String  @default("service")
  /// Rate for spot and Cyber Care overage work. Null on a flat service agreement.
  hourlyRate         Float?
  /// Which row of the shared spot-rate table this agreement quotes, for reporting.
  rateTier           String?
  /// Hours included per billing period on block and Cyber Care agreements.
  blockHoursIncluded Float   @default(0)
  /// Hours deducted so far in the current period, weighted the same way as billing.
  blockHoursUsed     Float   @default(0)
  overtimeEnabled    Boolean @default(true)
  /// Local clock time after which work is overtime, "HH:MM".
  overtimeAfter      String  @default("18:00")
  overtimeMultiplier Float   @default(1.5)

  // Relationships
  invoices      Invoice[]
  tickets       Ticket[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model BillingBatch {
  id          String   @id @default(uuid())
  /// Everything up to and including this date is what the batch bills.
  billThroughDate DateTime
  /// preview → approved | rejected. A batch is a review artefact: it holds draft invoices
  /// until somebody approves them.
  status      String   @default("preview")
  notes       String?
  createdById String
  approvedById String?
  approvedAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  invoices    Invoice[]

  @@index([status])
}

model Invoice {
  id             String   @id @default(uuid())
  invoiceNumber  String   @unique
  status         String   @default("draft")    // InvoiceStatus enum
  issueDate      DateTime @default(now())
  dueDate        DateTime
  paidAt         DateTime?
  subtotal       Float    @default(0)
  taxRate        Float    @default(0)
  taxTotal       Float    @default(0)
  total          Float    @default(0)
  currency       String   @default("USD")
  notes          String?

  // Quote workflow (FI-034)
  quoteStatus   String?  // null=regular invoice, "draft"|"sent"|"accepted"|"converted"|"declined"

  // Recurring (FI-037)
  isRecurring        Boolean  @default(false)
  recurrenceRule     String?  // "monthly"|"quarterly"|"annually"|cron
  nextGenerationDate DateTime?

  companyId      String
  company        Company  @relation(fields: [companyId], references: [id])
  agreementId    String?
