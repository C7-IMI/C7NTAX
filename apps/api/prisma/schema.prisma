model KnowledgeBaseArticle {
  id          String   @id @default(uuid())
  title       String
  slug        String   @unique
  content     String
  excerpt     String?
  status      String   @default("draft")
  visibility  String   @default("internal")
  categoryId  String?
  authorId    String
  viewCount   Int      @default(0)
  helpfulCount Int     @default(0)
  notHelpfulCount Int  @default(0)
  tags        String[] @default([])
