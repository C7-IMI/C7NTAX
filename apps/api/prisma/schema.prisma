// ─── Prisma Schema for C7NTAX ───────────────────────────────────
// Database: PostgreSQL 16
// ORM: Prisma Client

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── User & Auth ────────────────────────────────────────────────────

model User {
  id              String   @id @default(uuid())
  email           String   @unique
  username        String?  @unique
  passwordHash    String
  firstName       String
  lastName        String
  phone           String?
  mobile          String?
  title           String?
  avatarUrl       String?
  isActive        Boolean  @default(true)
  isLocked        Boolean  @default(false)
  loginAttempts   Int      @default(0)
  lastLoginAt     DateTime?
  emailVerified   Boolean  @default(false)

  // MFA
  mfaEnabled        Boolean  @default(false)
  mfaSecret         String?
  mfaBackupCodes    String[] @default([]) // hashed
  mfaEmailCode      String?
  mfaEmailCodeExpires DateTime?

  // Relationships
  roleId          String
  role            Role              @relation(fields: [roleId], references: [id])
  permissions     String[]          @default([])  // individual overrides (additive to role)
  companyId       String?
  company         Company?          @relation(fields: [companyId], references: [id])
  sessions        Session[]
  tickets         Ticket[]          @relation("AssignedTickets")
  createdTickets  Ticket[]          @relation("CreatedTickets")
  comments        TicketComment[]
  timeEntries     TimeEntry[]
  notifications   Notification[]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  systemRole  String   // SystemRole enum value
  permissions String[] // Permission enum values
  isDefault   Boolean  @default(false)
  users       User[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Session {
  id           String   @id @default(uuid())
  token        String   @unique
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ipAddress    String?
  userAgent    String?
  expiresAt    DateTime
  createdAt    DateTime @default(now())
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())
}

// ─── Company / Client ───────────────────────────────────────────────

model Company {
  id              String   @id @default(uuid())
  name            String
  legalName       String?
  taxId           String?
  phone           String?
  fax             String?
  email           String?
  billingEmail    String?
  website         String?
  addressLine1    String?
  addressLine2    String?
  city            String?
  state           String?
  postalCode      String?
  country         String?
  billingAddressLine1 String?
  billingAddressLine2 String?
  billingCity     String?
  billingState    String?
  billingPostalCode String?
  billingCountry  String?
  notes           String?
  isActive        Boolean  @default(true)
  clientId        Int?     @unique
  clientType      String?  @default("Client")
  companyType     String?  @default("Client") // Client, Prospect, Vendor, Partner
  industry        String?
  territory       String?
  region          String?
  currency        String?  @default("USD")
  accountManagerId String?
  primaryContactId String?
  serviceLevel    String?  // Standard, Premium, Enterprise

  // Portal access
  portalEnabled   Boolean  @default(false)

  // Relationships
  users           User[]
  contacts        Contact[]
  tickets         Ticket[]
  serviceAgreements ServiceAgreement[]
  invoices        Invoice[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Contact {
  id          String   @id @default(uuid())
  firstName   String
  lastName    String
  email       String
  phone       String?
  mobile      String?
  title       String?
  department  String?
  notes       String?
  isPrimary   Boolean  @default(false)
  isActive    Boolean  @default(true)

  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  tickets     Ticket[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ─── Service Boards ─────────────────────────────────────────────────

model ServiceBoard {
  id              String   @id @default(uuid())
  name            String
  description     String?
  isActive        Boolean  @default(true)

  // SLA defaults
  slaResponseMinutes   Int  @default(240)   // 4 hours
  slaResolutionMinutes Int  @default(1440)  // 24 hours

  // Auto-close config
  autoCloseEnabled     Boolean @default(true)
  autoCloseDays        Int     @default(14)

  // Follow-up email config
  followUpEnabled      Boolean @default(true)
  followUpIntervalHours Int    @default(24)

  // Relationships
  tickets         Ticket[]
  emailConnectors EmailConnector[]
  categories      TicketCategory[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model TicketCategory {
  id        String  @id @default(uuid())
  name      String
  boardId   String
  board     ServiceBoard @relation(fields: [boardId], references: [id], onDelete: Cascade)
  tickets   Ticket[]

  @@unique([boardId, name])
}

// ─── Email Connectors ──────────────────────────────────────────────

model EmailConnector {
  id                String   @id @default(uuid())
  boardId           String
  board             ServiceBoard @relation(fields: [boardId], references: [id], onDelete: Cascade)
  host              String
  port              Int      @default(993)
  secure            Boolean  @default(true)
  user              String
  passwordEncrypted String
  folder            String   @default("INBOX")
  pollIntervalSec   Int      @default(60)
  enabled           Boolean  @default(true)
  lastPollAt        DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

// ─── Tickets ────────────────────────────────────────────────────────

model Ticket {
  id          String   @id @default(uuid())
  ticketNumber String  @unique // Auto-generated e.g. C7-00000001
  title       String
  description String?
  status      String   @default("new")       // TicketStatus enum
  priority    String   @default("medium")    // TicketPriority enum
  source      String   @default("portal")    // TicketSource enum
  dueDate     DateTime?
  startTime   DateTime?
  endTime     DateTime?

  // SLA tracking
  slaResponseDue    DateTime?
  slaResolutionDue  DateTime?
  firstResponseAt   DateTime?
  resolvedAt        DateTime?
  closedAt          DateTime?
  isOverdue         Boolean   @default(false) // Auto-set when dueDate passes

  // Auto-close tracking
  waitingSince      DateTime?  // When status changed to waiting_on_client
  followUpCount     Int        @default(0)
  lastFollowUpAt    DateTime?

  // Relationships
  boardId       String
  board         ServiceBoard     @relation(fields: [boardId], references: [id])
  categoryId    String?
  category      TicketCategory?  @relation(fields: [categoryId], references: [id])
  companyId     String
  company       Company          @relation(fields: [companyId], references: [id])
  contactId     String?
  contact       Contact?         @relation(fields: [contactId], references: [id])
  assignedToId  String?
  assignedTo    User?            @relation("AssignedTickets", fields: [assignedToId], references: [id])
  createdById   String
  createdBy     User             @relation("CreatedTickets", fields: [createdById], references: [id])

  // Thread
  comments      TicketComment[]
  attachments   TicketAttachment[]
  timeEntries   TimeEntry[]
  notifications Notification[]

  // Tags / metadata
  tags          String[]  @default([])
  customFields  Json      @default("{}")

  // Service agreement link
  serviceAgreementId String?
  serviceAgreement   ServiceAgreement? @relation(fields: [serviceAgreementId], references: [id])

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model TicketComment {
  id          String   @id @default(uuid())
  body        String
  isInternal  Boolean  @default(false)
  isEmail     Boolean  @default(false) // true if ingested from email
  fromEmail   String?  // sender email if email-sourced

  ticketId    String
  ticket      Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId    String
  author      User     @relation(fields: [authorId], references: [id])

  attachments TicketAttachment[]


  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model TicketAttachment {
  id          String   @id @default(uuid())
  filename    String
  mimeType    String
  size        Int
  storagePath String
  ticketId    String?
  ticket      Ticket?  @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  commentId   String?
  comment     TicketComment? @relation(fields: [commentId], references: [id], onDelete: Cascade)
  uploadedById String

  createdAt   DateTime @default(now())
}

// ─── Time Entry ─────────────────────────────────────────────────────

model TimeEntry {
  id          String   @id @default(uuid())
  description String?
  minutes     Int
  billable    Boolean  @default(true)
  rate        Float?
  date        DateTime @default(now())

  ticketId    String
  ticket      Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id])

  invoiceId   String?
  invoice     Invoice? @relation(fields: [invoiceId], references: [id])


  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ─── Service Agreements & Billing ──────────────────────────────────

model ServiceAgreement {
  id            String   @id @default(uuid())
  name          String
  description   String?
  companyId     String
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  isActive      Boolean  @default(true)

  // Billing config
  billingPeriod String   @default("monthly")   // BillingPeriod enum
  billingAmount Float    @default(0)
  currency      String   @default("USD")
  taxRate       Float    @default(0)            // e.g. 0.0825 = 8.25%

  // Dates
  startDate     DateTime
  endDate       DateTime?
  nextInvoiceDate DateTime?

  // Auto-invoice settings
  autoInvoiceEnabled    Boolean @default(true)
  invoiceDayOfMonth     Int     @default(1)
  invoiceAdvanceDays    Int     @default(7)

  // Auto follow-up for unpaid
  followUpEnabled       Boolean @default(true)
  followUpIntervalDays  Int     @default(7)
  maxFollowUps          Int     @default(3)

  // Relationships
  invoices      Invoice[]
  tickets       Ticket[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Invoice {
  id             String   @id @default(uuid())
  invoiceNumber  String   @unique
  status         String   @default("draft")    // InvoiceStatus enum
  issueDate      DateTime @default(now())
  dueDate        DateTime
  paidAt         DateTime?
  subtotal       Float    @default(0)
  taxRate        Float    @default(0)
  taxTotal       Float    @default(0)
  total          Float    @default(0)
  currency       String   @default("USD")
  notes          String?

  companyId      String
  company        Company  @relation(fields: [companyId], references: [id])
  agreementId    String?
  agreement      ServiceAgreement? @relation(fields: [agreementId], references: [id])

  lineItems      InvoiceLineItem[]
  timeEntries    TimeEntry[]
  payments       Payment[]

  // Follow-up tracking
  followUpCount    Int     @default(0)
  lastFollowUpAt   DateTime?
  nextFollowUpAt   DateTime?

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model InvoiceLineItem {
  id          String  @id @default(uuid())
  description String
  quantity    Float   @default(1)
  unitPrice   Float
  total       Float
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

model Payment {
  id            String   @id @default(uuid())
  amount        Float
  method        String   // "credit_card", "ach", "check", "wire", "flexpoint", "other"
  reference     String?  // external transaction ID
  processedAt   DateTime @default(now())

  invoiceId     String
  invoice       Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  createdAt     DateTime @default(now())
}

// ─── Integration Configs ────────────────────────────────────────────

model Integration {
  id            String   @id @default(uuid())
  kind          String   // IntegrationKind
  name          String
  enabled       Boolean  @default(false)
  credentials   Json     @default("{}")   // encrypted creds
  settings      Json     @default("{}")
  lastSyncAt    DateTime?
  status        String   @default("disconnected")
  errorMessage  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ─── Microsoft 365 Synced Data ─────────────────────────────────────

model M365User {
  id              String   @id @default(uuid())
  integrationId   String
  azureObjectId   String   @unique
  userPrincipalName String
  displayName     String
  givenName       String?
  surname         String?
  mail            String?
  jobTitle        String?
  department      String?
  officeLocation  String?
  mobilePhone     String?
  businessPhone   String?
  usageLocation   String?
  accountEnabled  Boolean  @default(true)
  contactId       String?
  raw             Json     @default("{}")
  lastSyncedAt    DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model M365Group {
  id              String   @id @default(uuid())
  integrationId   String
  azureObjectId   String   @unique
  displayName     String
  description     String?
  mail            String?
  visibility      String?
  memberCount     Int      @default(0)
  raw             Json     @default("{}")
  lastSyncedAt    DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model M365Subscription {
  id              String   @id @default(uuid())
  integrationId   String
  skuId           String
  skuPartNumber   String
  displayName     String
  enabled         Int      @default(0)
  suspended       Int      @default(0)
  assigned        Int      @default(0)
  unit            String   @default("user")
  raw             Json     @default("{}")
  lastSyncedAt    DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model SyncLog {
  id              String   @id @default(uuid())
  integrationId   String
  status          String   @default("running")
  entityType      String
  recordsProcessed Int     @default(0)
  recordsCreated  Int      @default(0)
  recordsUpdated  Int      @default(0)
  recordsFailed   Int      @default(0)
  errorMessage    String?
  startedAt       DateTime @default(now())
  completedAt     DateTime?
  createdAt       DateTime @default(now())
}

// ─── Generic Synced Entity (for all integration types) ─────────────

model SyncedEntity {
  id              String   @id @default(uuid())
  integrationId   String
  entityKind      String   // e.g. "connectwise", "halopsa", "itglue"
  entityType      String   // e.g. "ticket", "contact", "invoice"
  externalId      String   // unique ID from the external system
  displayName     String?
  data            Json     @default("{}")  // raw JSON from the API
  linkedContactId String?  // optional link to a Contact record
  linkedCompanyId String?  // optional link to a Company record
  lastSyncedAt    DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([integrationId, entityType, externalId])
  @@index([integrationId, entityType])
  @@index([linkedContactId])
}

// ─── Notifications ──────────────────────────────────────────────────

model Notification {
  id        String   @id @default(uuid())
  type      String   // "ticket_assigned", "ticket_updated", "invoice_sent", "sla_breach", etc.
  title     String
  body      String
  isRead    Boolean  @default(false)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ticketId  String?
  ticket    Ticket?  @relation(fields: [ticketId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
}

// ─── Audit Log ──────────────────────────────────────────────────────

model AuditLog {
  id        String   @id @default(uuid())
  action    String
  entity    String
  entityId  String
  changes   Json     @default("{}")
  userId    String
  ipAddress String?
  createdAt DateTime @default(now())
}

// ─── System Config ──────────────────────────────────────────────────

model SystemConfig {
  key   String @unique
  value Json   @default("{}")
}

// ═══════════════════════════════════════════════════════════════════
//  NEW MODELS — Feature Implementation
//  All FK relations use scalar columns + @@index, no Prisma relations
//  to avoid requiring opposite fields on existing models.
// ═══════════════════════════════════════════════════════════════════

model AiProviderConfig {
  id            String   @id @default(uuid())
  name          String   @unique
  provider      String
  isActive      Boolean  @default(false)
  isDefault     Boolean  @default(false)
  apiKey        String?
  apiEndpoint   String?
  model         String   @default("gpt-4o-mini")
  maxTokens     Int      @default(2000)
  temperature   Float    @default(0.3)
  topP          Float    @default(1.0)
  config        Json     @default("{}")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model InferenceCache {
  id          String   @id @default(uuid())
  ticketId    String
  providerId  String
  requestType String
  requestHash String
  response    Json     @default("{}")
  tokensUsed  Int      @default(0)
  costEstimate Float   @default(0)
  latencyMs   Int      @default(0)
  hitCount    Int      @default(0)
  expiresAt   DateTime?

  createdAt   DateTime @default(now())
  @@index([ticketId])
  @@index([requestHash])
  @@index([providerId])
}

model TicketSimilarity {
  id              String   @id @default(uuid())
  ticketId        String
  similarTicketId String
  score           Float
  method          String
  createdAt       DateTime @default(now())
  @@unique([ticketId, similarTicketId])
  @@index([ticketId])
}

model DetectedPattern {
  id          String   @id @default(uuid())
  name        String
  description String?
  category    String
  severity    String   @default("medium")
  entityType  String
  entityIds   String[] @default([])
  metrics     Json     @default("{}")
  status      String   @default("open")
  detectedAt  DateTime @default(now())
  resolvedAt  DateTime?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model WebhookConfig {
  id        String   @id @default(uuid())
  name      String
  url       String
  secret    String
  events    String[] @default([])
  isActive  Boolean  @default(true)
  retryCount Int     @default(3)
  createdAt DateTime @default(now())
}

model Opportunity {
  id              String   @id @default(uuid())
  name            String
  companyId       String
  contactId       String?
  stage           String   @default("prospect")
  probability     Int      @default(0)
  amount          Float    @default(0)
  currency        String   @default("USD")
  expectedCloseDate DateTime?
  closedAt        DateTime?
  wonReason       String?
  lostReason      String?
  assignedToId    String?
  notes           String?
  customFields    Json     @default("{}")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model SalesActivity {
  id            String   @id @default(uuid())
  opportunityId String
  type          String
  subject       String
  body          String?
  userId        String
  scheduledAt   DateTime?
  completedAt   DateTime?
  createdAt     DateTime @default(now())
  @@index([opportunityId])
}

model TechnicianSkill {
  id        String @id @default(uuid())
  userId    String
  skill     String
  level     Int    @default(1)
  createdAt DateTime @default(now())
  @@unique([userId, skill])
}

model ScheduleEntry {
  id          String   @id @default(uuid())
  userId      String
  ticketId    String?
  title       String
  description String?
  startTime   DateTime
  endTime     DateTime
  status      String   @default("scheduled")
  location    String?
  travelTime  Int?
  color       String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@index([userId])
}

model Project {
  id              String   @id @default(uuid())
  name            String
  description     String?
  companyId       String
  status          String   @default("planning")
  priority        String   @default("medium")
  startDate       DateTime?
  endDate         DateTime?
  actualStartDate DateTime?
  actualEndDate   DateTime?
  budget          Float    @default(0)
  budgetSpent     Float    @default(0)
  currency        String   @default("USD")
  managerId       String?
  customFields    Json     @default("{}")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model ProjectPhase {
  id          String   @id @default(uuid())
  projectId   String
  name        String
  description String?
  sortOrder   Int      @default(0)
  startDate   DateTime?
  endDate     DateTime?
  status      String   @default("pending")

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ProjectTask {
  id              String   @id @default(uuid())
  phaseId         String
  name            String
  description     String?
  sortOrder       Int      @default(0)
  status          String   @default("pending")
  estimatedHours  Float?
  actualHours     Float?
  assignedToId    String?
  startDate       DateTime?
  endDate         DateTime?
  ticketId        String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model ProjectTaskDependency {
  id          String @id @default(uuid())
  taskId      String
  dependsOnId String
  type        String @default("finish_to_start")
  lagMinutes  Int    @default(0)
  @@unique([taskId, dependsOnId])
}

model Asset {
  id              String   @id @default(uuid())
  name            String
  assetTag        String   @unique
  serialNumber    String?
  model           String?
  manufacturer    String?
  type            String   // hardware, software, license, server, laptop, mobile, network, other
  category        String?  // workstation, peripheral, infrastructure, cloud, saas
  status          String   @default("available") // available, assigned, maintenance, retired, lost
  department      String?
  vendor          String?
  purchaseDate    DateTime?
  purchasePrice   Float?
  purchaseOrder   String?
  warrantyExpiry  DateTime?
  location        String?
  building        String?
  room            String?
  companyId       String?
  assignedToId    String?
  costCenter      String?
  depreciationMethod String? // straight_line, declining_balance, none
  usefulLife      Int?     // months
  salvageValue    Float?
  ipAddress       String?
  macAddress      String?
  osName          String?
  osVersion       String?
  installedSoftware Json?  @default("[]")
  notes           String?
  customFields    Json     @default("{}")
  lastAuditedAt   DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model AssetAssignment {
  id          String   @id @default(uuid())
  assetId     String
  assignedToId String?
  ticketId    String?
  checkedOutAt DateTime @default(now())
  checkedInAt  DateTime?
  notes       String?

  createdAt   DateTime @default(now())
}

model Contract {
  id              String   @id @default(uuid())
  name            String
  contractNumber  String   @unique
  companyId       String
  type            String
  status          String   @default("active")
  startDate       DateTime
  endDate         DateTime
  renewalDate     DateTime?
  autoRenew       Boolean  @default(false)
  value           Float    @default(0)
  currency        String   @default("USD")
  billingPeriod   String?
  serviceAgreementId String?
  notifiedAt      DateTime?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model ContractMilestone {
  id          String   @id @default(uuid())
  contractId  String
  name        String
  description String?
  dueDate     DateTime
  completedAt DateTime?
  amount      Float?
  status      String   @default("pending")

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Vendor {
  id          String   @id @default(uuid())
  name        String
  contactName String?
  email       String?
  phone       String?
  website     String?
  address     String?
  taxId       String?
  paymentTerms String?
  isActive    Boolean  @default(true)
  notes       String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model PurchaseOrder {
  id          String   @id @default(uuid())
  poNumber    String   @unique
  vendorId    String
  status      String   @default("draft")
  subtotal    Float    @default(0)
  taxTotal    Float    @default(0)
  total       Float    @default(0)
  currency    String   @default("USD")
  orderedAt   DateTime?
  expectedAt  DateTime?
  receivedAt  DateTime?
  approvedById String?
  createdById String
  notes       String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model POLineItem {
  id          String @id @default(uuid())
  poId        String
  description String
  quantity    Float  @default(1)
  unitPrice   Float
  total       Float
  assetId     String?
}

model PtoRequest {
  id          String   @id @default(uuid())
  userId      String
  type        String
  status      String   @default("pending")
  startDate   DateTime
  endDate     DateTime
  hours       Float
  reason      String?
  approvedById String?
  approvedAt  DateTime?
  deniedReason String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Holiday {
  id        String   @id @default(uuid())
  name      String
  date      DateTime
  recurring Boolean  @default(true)
  country   String   @default("US")
  region    String?
  createdAt DateTime @default(now())
}

model Survey {
  id          String   @id @default(uuid())
  name        String
  description String?
  type        String   @default("csat")
  isActive    Boolean  @default(true)
  sendOnResolve Boolean @default(false)
  sendDelayHours Int   @default(1)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SurveyQuestion {
  id        String  @id @default(uuid())
  surveyId  String
  text      String
  type      String  @default("rating")
  required  Boolean @default(true)
  sortOrder Int     @default(0)
  choices   Json    @default("[]")
}

model SurveyResponse {
  id          String   @id @default(uuid())
  surveyId    String
  ticketId    String?
  companyId   String?
  userId      String?
  npsScore    Int?
  completedAt DateTime @default(now())

  createdAt   DateTime @default(now())
}

model SurveyAnswer {
  id         String @id @default(uuid())
  responseId String
  questionId String
  value      String
}

model KnowledgeBaseArticle {
  id          String   @id @default(uuid())
  title       String
  slug        String   @unique
  content     String
  excerpt     String?
  status      String   @default("draft")
  visibility  String   @default("internal")
  categoryId  String?
  authorId    String
  viewCount   Int      @default(0)
  helpfulCount Int     @default(0)
  notHelpfulCount Int  @default(0)
  tags        String[] @default([])

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model KBCategory {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  description String?
  parentId    String?
  sortOrder   Int      @default(0)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model KBArticleVersion {
  id         String   @id @default(uuid())
  articleId  String
  version    Int
  content    String
  changeNote String?
  authorId   String
  createdAt  DateTime @default(now())
  @@unique([articleId, version])
}

model KBArticleAttachment {
  id           String   @id @default(uuid())
  articleId    String
  filename     String
  mimeType     String
  size         Int
  storagePath  String
  uploadedById String
  createdAt    DateTime @default(now())
}

model KBArticleTicket {
  id         String   @id @default(uuid())
  articleId  String
  ticketId   String
  linkedById String
  createdAt  DateTime @default(now())
  @@unique([articleId, ticketId])
}

model ChatSession {
  id           String   @id @default(uuid())
  status       String   @default("active")
  companyId    String?
  userId       String?
  guestName    String?
  guestEmail   String?
  assignedToId String?
  ticketId     String?
  startedAt    DateTime @default(now())
  closedAt     DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model ChatMessage {
  id          String   @id @default(uuid())
  sessionId   String
  senderType  String
  senderId    String?
  content     String
  contentType String   @default("text")
  isRead      Boolean  @default(false)

  createdAt   DateTime @default(now())
}

model WorkflowRule {
  id          String   @id @default(uuid())
  name        String
  description String?
  entity      String
  trigger     String
  conditions  Json     @default("[]")
  isActive    Boolean  @default(true)
  priority    Int      @default(0)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model WorkflowRuleAction {
  id        String @id @default(uuid())
  ruleId    String
  type      String
  config    Json   @default("{}")
  sortOrder Int    @default(0)
}

model WorkflowExecution {
  id          String   @id @default(uuid())
  ruleId      String
  entityId    String
  status      String   @default("running")
  result      Json     @default("{}")
  startedAt   DateTime @default(now())
  completedAt DateTime?
}

model Report {
  id          String   @id @default(uuid())
  name        String
  description String?
  type        String
  config      Json     @default("{}")
  isSystem    Boolean  @default(false)
  createdById String

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ReportSchedule {
  id         String   @id @default(uuid())
  reportId   String
  frequency  String
  dayOfWeek  Int?
  dayOfMonth Int?
  timeOfDay  String
  recipients String[]
  format     String   @default("pdf")
  isActive   Boolean  @default(true)
  lastSentAt DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model FieldPermission {
  id       String  @id @default(uuid())
  entity   String
  field    String
  roleName String
  canRead  Boolean @default(true)
  canWrite Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([entity, field, roleName])
}

model SsoConfig {
  id       String   @id @default(uuid())
  name     String
  provider String
  isActive Boolean  @default(false)
  config   Json     @default("{}")
  domains  String[] @default([])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Locale {
  id        String  @id @default(uuid())
  code      String  @unique
  name      String
  isActive  Boolean @default(true)
  isDefault Boolean @default(false)
  direction String  @default("ltr")
  createdAt DateTime @default(now())
}

model Translation {
  id        String @id @default(uuid())
  localeCode String
  key       String
  value     String
  namespace String @default("common")
  updatedAt DateTime @updatedAt
  @@unique([localeCode, key, namespace])
}

model Currency {
  code          String  @id
  name          String
  symbol        String
  decimalPlaces Int     @default(2)
  isActive      Boolean @default(true)
  createdAt     DateTime @default(now())
}

model ExchangeRate {
  id           String   @id @default(uuid())
  fromCurrency String
  toCurrency   String
  rate         Float
  updatedAt    DateTime @updatedAt
  @@unique([fromCurrency, toCurrency])
}

model RetentionPolicy {
  id           String   @id @default(uuid())
  entity       String
  retentionDays Int
  archiveAction String  @default("archive")
  condition    Json     @default("{}")
  isActive     Boolean  @default(true)
  lastRunAt    DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  @@unique([entity])
}

model CalendarSyncConfig {
  id                   String   @id @default(uuid())
  userId               String
  provider             String
  accessToken          String
  refreshToken         String?
  tokenExpiry          DateTime?
  calendarId           String?
  syncScheduleEntries  Boolean  @default(true)
  syncPto              Boolean  @default(true)
  lastSyncAt           DateTime?
  isActive             Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  @@unique([userId, provider])
}

model BulkOperation {
  id           String   @id @default(uuid())
  type         String
  status       String   @default("pending")
  entity       String
  config       Json     @default("{}")
  totalCount   Int      @default(0)
  successCount Int      @default(0)
  failureCount Int      @default(0)
  errors       Json     @default("[]")
  createdById  String
  startedAt    DateTime?
  completedAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ═══════════════════════════════════════════════════════════════════

// ═══════════════════════════════════════════════════════════════════
//  KUMO — IT Documentation & Asset Management Module
// ═══════════════════════════════════════════════════════════════════

model KumoLink {
  id            String   @id @default(uuid())
  sourceType    String
  sourceId      String
  targetType    String
  targetId      String
  relationship  String   @default("related_to")
  label         String?
  notes         String?
  isDirectional Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdById   String
  createdAt     DateTime @default(now())

  @@index([sourceType, sourceId])
  @@index([targetType, targetId])
  @@index([sourceType, sourceId, targetType, targetId])
}

model KumoAssetTemplate {
  id          String   @id @default(uuid())
  name        String
  description String?
  icon        String?
  color       String?  @default("#3b82d6")
  isBuiltIn   Boolean  @default(false)
  isActive    Boolean  @default(true)
  companyId   String?
  fields      KumoTemplateField[]
  assets      KumoAsset[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model KumoTemplateField {
  id           String            @id @default(uuid())
  templateId   String
  template     KumoAssetTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  key          String
  label        String
  fieldType    String            @default("text")
  required     Boolean           @default(false)
  options      Json?
  placeholder  String?
  helpText     String?
  defaultValue Json?
  isSensitive  Boolean           @default(false)
  encrypted    Boolean           @default(false)
  sortOrder    Int               @default(0)
  values       KumoAssetFieldValue[] @relation("FieldToValues")

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([templateId, key])
}

model KumoAsset {
  id            String            @id @default(uuid())
  templateId    String
  template      KumoAssetTemplate @relation(fields: [templateId], references: [id])
  name          String
  status        String            @default("active")
  companyId     String?
  tags          String[]          @default([])
  createdById   String
  updatedById   String?
  fieldValues   KumoAssetFieldValue[] @relation("AssetToValues")
  configServer      KumoServer?
  configWorkstation KumoWorkstation?
  configNetwork     KumoNetworkDevice?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([templateId, companyId])
}

model KumoAssetFieldValue {
  id             String            @id @default(uuid())
  assetId        String
  asset          KumoAsset         @relation("AssetToValues", fields: [assetId], references: [id], onDelete: Cascade)
  fieldId        String
  field          KumoTemplateField @relation("FieldToValues", fields: [fieldId], references: [id])
  valueText      String?
  valueNum       Float?
  valueBool      Boolean?
  valueDate      DateTime?
  valueJson      Json?
  encryptedValue String?

  @@unique([assetId, fieldId])
  @@index([fieldId])
}

model KumoServer {
  id              String    @id @default(uuid())
  kumoAssetId     String    @unique
  kumoAsset       KumoAsset @relation(fields: [kumoAssetId], references: [id], onDelete: Cascade)
  hostname        String
  fqdn            String?
  operatingSystem String?
  osVersion       String?
  cpuCores        Int?
  ramGb           Int?
  storageGb       Int?
  ipAddress       String?
  macAddress      String?
  virtualization  String?
  hypervisorHost  String?
  lastPatchedAt   DateTime?
}

model KumoWorkstation {
  id              String    @id @default(uuid())
  kumoAssetId     String    @unique
  kumoAsset       KumoAsset @relation(fields: [kumoAssetId], references: [id], onDelete: Cascade)
  hostname        String
  operatingSystem String?
  serialNumber    String?
  assignedUserId  String?
  lastCheckInAt   DateTime?
}

model KumoNetworkDevice {
  id              String    @id @default(uuid())
  kumoAssetId     String    @unique
  kumoAsset       KumoAsset @relation(fields: [kumoAssetId], references: [id], onDelete: Cascade)
  deviceType      String    @default("switch")
  managementIp    String?
  macAddress      String?
  firmwareVersion String?
  portCount       Int?
  serialNumber    String?
  rackPosition    String?
}

model KumoPassword {
  id                String   @id @default(uuid())
  label             String
  username          String?
  email             String?
  url               String?
  encryptedPassword String
  encryptionKeyId   String
  iv                String
  authTag           String
  passwordPolicy    String?
  expiresAt         DateTime?
  category          String?
  strength          String?
  notes             String?
  companyId         String?
  totpSecret        String?
  totpEnabled       Boolean  @default(false)
  isActive          Boolean  @default(true)
  createdById       String
  updatedById       String?
  accessLogs        KumoPasswordAccessLog[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([companyId, category])
}

model KumoPasswordAccessLog {
  id            String       @id @default(uuid())
  passwordId    String
  password      KumoPassword @relation(fields: [passwordId], references: [id], onDelete: Cascade)
  accessedById  String
  accessedAt    DateTime     @default(now())
  accessType    String
  ipAddress     String?
  userAgent     String?
  success       Boolean      @default(true)
  failureReason String?

  @@index([passwordId, accessedAt])
  @@index([accessedById])
}

model KumoFolder {
  id          String       @id @default(uuid())
  name        String
  slug        String
  description String?
  parentId    String?
  parent      KumoFolder?  @relation("FolderHierarchy", fields: [parentId], references: [id])
  children    KumoFolder[] @relation("FolderHierarchy")
  sortOrder   Int          @default(0)
  companyId   String?
  documents   KumoDocument[]

  @@unique([slug, parentId, companyId])
  @@index([parentId])
}

model KumoDocument {
  id             String      @id @default(uuid())
  folderId       String?
  folder         KumoFolder? @relation(fields: [folderId], references: [id])
  title          String
  slug           String
  currentContent String
  currentVersion Int         @default(1)
  status         String      @default("draft")
  visibility     String      @default("internal")
  sortOrder      Int         @default(0)
  companyId      String?
  tags           String[]    @default([])
  authorId       String
  lastEditorId   String?
  viewCount      Int         @default(0)
  isTemplate     Boolean     @default(false)
  revisions      KumoDocumentRevision[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([folderId, sortOrder])
  @@index([companyId, status])
}

model KumoDocumentRevision {
  id         String        @id @default(uuid())
  documentId String
  document   KumoDocument  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  version    Int
  content    String
  changeLog  String?
  authorId   String
  fileSize   Int?
  createdAt  DateTime      @default(now())

  @@unique([documentId, version])
  @@index([documentId, createdAt])
}

// ── FlowIngest: Domain Tracking ───────────────────────────────────

model KumoDomain {
  id          String   @id @default(uuid())
  domainName  String
  registrar   String?
  expiryDate  DateTime?
  autoRenew   Boolean  @default(true)
  dnsProvider String?
  nameservers String[] @default([])
  notes       String?
  companyId   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([companyId])
  @@index([expiryDate])
}
