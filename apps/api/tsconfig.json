{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist"
  },
  "include": ["src"],
  /*
   * The seeding and post-change scripts are outside the strict gate on purpose.
   *
   * They are entry points run by hand with `tsx` (db:seed-full, db:seed-tabs, verify) and are never
   * imported by the server or reached by a request — they are fixtures written against sample data,
   * so their errors are shape drift in throwaway scripts rather than defects in anything that ships.
   * Between them they were 73 of this project's 149 type errors, which made a check about shipped
   * code look like a check about sample data. They still fail loudly when run, which is where a
   * seeding script is actually run.
   */
  "exclude": ["node_modules", "dist", "build", ".turbo", "src/seed-*.ts", "src/verify-post-change.ts"]
}
