{
  "name": "@C7NTAX/api",
  "version": "1.0.0",
  "private": true,
  "main": "./src/index.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "start:production": "node --import tsx src/index.ts",
    "lint": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:status": "prisma migrate status",
    "db:seed": "tsx src/seed.ts",
    "db:seed-full": "tsx src/seed-full.ts",
    "db:seed-auto": "tsx src/seed-automation.ts",
    "db:seed-from-snapshots": "tsx src/seed-from-snapshots.ts",
    "db:capture": "tsx src/snapshot-capture.ts",
    "db:seed-coverage": "tsx src/seed-sample-coverage.ts",
    "db:reseed": "tsx src/snapshot-capture.ts && tsx src/seed-from-snapshots.ts",
    "db:sample-off": "tsx src/sample-data-toggle.ts off",
    "db:sample-on": "tsx src/sample-data-toggle.ts on",
    "db:types-off": "tsx src/kumo-types-toggle.ts off",
    "db:types-on": "tsx src/kumo-types-toggle.ts on",
    "verify": "tsx src/verify-post-change.ts",
    "kumo:reencrypt": "tsx src/reencrypt-kumo-vault.ts",
    "kumo:reencrypt:apply": "tsx src/reencrypt-kumo-vault.ts --apply",
    "probe:email": "tsx src/email-studio-probe.ts",
    "probe:kumo-key": "tsx src/kumo-key-probe.ts",
    "probes:sweep": "tsx clean-probe-residue.ts",
    "probes:sweep:apply": "tsx clean-probe-residue.ts --apply",
    "db:snapshot": "tsx src/seed-automation.ts",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@C7NTAX/email": "workspace:*",
    "@C7NTAX/integrations": "workspace:*",
    "@C7NTAX/shared": "workspace:*",
    "@prisma/client": "^5.14.0",
    "@simplewebauthn/server": "^13.3.2",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.4.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^4.19.0",
    "express-rate-limit": "^7.3.0",
    "helmet": "^7.1.0",
    "ioredis": "^5.4.0",
    "jsonwebtoken": "^9.0.0",
    "morgan": "^1.12.0",
    "otplib": "^12.0.0",
    "prisma": "^5.14.0",
    "qrcode": "^1.5.0",
    "speakeasy": "^2.0.0",
    "swagger-ui-express": "^5.0.0",
    "tsx": "^4.10.0",
    "uuid": "^11.1.1",
    "ws": "^8.17.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.0",
    "@types/express": "^4.17.0",
    "@types/jsonwebtoken": "^9.0.0",
    "@types/morgan": "^1.9.0",
    "@types/qrcode": "^1.5.0",
    "@types/swagger-ui-express": "^4.1.0",
    "@types/uuid": "^11.0.0",
    "@types/ws": "^8.5.0",
    "rimraf": "^5.0.0",
    "typescript": "^5.4.0"
  }
}
