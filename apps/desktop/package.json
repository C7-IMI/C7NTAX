{
  "name": "@c7-overwatch/desktop",
  "version": "1.0.0",
  "private": true,
  "main": "./dist/main.js",
  "scripts": {
    "dev": "electron .",
    "build": "tsc && electron-builder --win portable",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "electron-is-dev": "^2.0.0"
  },
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^24.13.0",
    "typescript": "^5.4.0",
    "rimraf": "^5.0.0"
  },
  "build": {
    "appId": "com.cyber7group.c7overwatch",
    "productName": "C7 Overwatch",
    "directories": { "output": "release" },
    "win": {
      "target": ["nsis", "portable"],
      "icon": "assets/icon.ico",
      "artifactName": "C7-Overwatch-${version}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "shortcutName": "C7 Overwatch"
    },
    "portable": {
      "artifactName": "C7-Overwatch-Portable-${version}.exe"
    }
  }
}
