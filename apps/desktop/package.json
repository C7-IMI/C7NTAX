{
  "name": "@C7NTAX/desktop",
  "version": "1.0.0",
  "private": true,
  "main": "./dist/main.js",
  "scripts": {
    "dev": "electron .",
    "build": "tsc && electron-builder --win portable",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "electron-is-dev": "^2.0.0"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^24.13.0",
    "rimraf": "^5.0.0",
    "typescript": "^5.4.0"
  },
  "build": {
    "appId": "com.cyber7group.C7NTAX",
    "productName": "C7NTAX",
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      
      "artifactName": "C7NTAX-${version}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "shortcutName": "C7NTAX"
    },
    "portable": {
      "artifactName": "C7NTAX-Portable-${version}.exe"
    }
  }
}
