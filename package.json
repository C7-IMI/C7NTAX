{
  "name": "C7NTAX",
  "version": "1.0.0",
  "private": true,
  "description": "C7NTAX — Professional Services Automation platform replicating AutoTask PSA",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "format": "prettier --write .",
    "db:generate": "turbo run db:generate",
    "db:push": "turbo run db:push",
    "db:migrate": "turbo run db:migrate",
    "db:sample-off": "pnpm --filter @C7NTAX/api db:sample-off",
    "db:sample-on": "pnpm --filter @C7NTAX/api db:sample-on",
    "clean": "turbo run clean && rimraf node_modules"
  },
  "devDependencies": {
    "@types/speakeasy": "^2.0.10",
    "prettier": "^3.2.0",
    "rimraf": "^5.0.0",
    "turbo": "^1.13.0",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.1.0"
}
