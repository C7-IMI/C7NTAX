{
  "name": "C7NTAX",
  "version": "1.0.0",
  "private": true,
  "description": "C7NTAX — Professional Services Automation platform replicating AutoTask PSA",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "pnpm": {
    "overrides": {
      "proxy-addr@<2.0.8": "^2.0.8",
      "brace-expansion@<1.1.21": "^1.1.21",
      "brace-expansion@>=2.0.0 <2.1.7": "2.1.7",
      "semver@<5.7.2": "^5.7.2",
      "qs@<6.16.0": "^6.16.0",
      "dompurify@<3.4.16": "^3.4.16"
    }
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "format": "prettier --write .",
    "db:generate": "turbo run db:generate",
    "db:push": "turbo run db:push",
    "db:migrate": "turbo run db:migrate",
    "db:sample-off": "pnpm --filter @C7NTAX/api db:sample-off",
    "db:sample-on": "pnpm --filter @C7NTAX/api db:sample-on",
    "clean": "turbo run clean && rimraf node_modules",
    "guard:routes": "node scripts/check-route-guards.mjs"
  },
  "devDependencies": {
    "@types/speakeasy": "^2.0.10",
    "prettier": "^3.2.0",
    "rimraf": "^5.0.0",
    "turbo": "^1.13.0",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.1.0"
}
