# ── C7 Overwatch Environment Configuration ──────────────────────────

# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/c7_overwatch?schema=public"

# JWT
JWT_SECRET="change-this-to-a-random-64-char-string-in-production"

# Email (SMTP)
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_USER="noreply@cyber7group.com"
SMTP_PASS="your-smtp-password"
SMTP_FROM="C7 Overwatch <noreply@cyber7group.com>"

# CORS
CORS_ORIGIN="http://localhost:5173"

# Redis (for BullMQ background jobs)
REDIS_URL="redis://localhost:6379"

# Port
PORT=4000

# Node environment
NODE_ENV="development"
